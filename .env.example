# Public address (no trailing slash). Must be HTTPS for MCP clients.
PUBLIC_BASE_URL=https://sewasetu.example.in
# Hostname Caddy gets a certificate for (same host as above, without https://)
DOMAIN=sewasetu.example.in

# Officer login (the one you give the assessors)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Generate each with: openssl rand -hex 32
SECRET_KEY=
INTERNAL_API_KEY=

# Only needed to run the model evals
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
SIMULATOR_MODEL=claude-sonnet-5-5
